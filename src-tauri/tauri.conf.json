{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote Mic",
  "version": "0.7.4",
  "identifier": "com.remotemic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:installer",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Remote Mic",
        "width": 1000,
        "height": 700,
        "minWidth": 780,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "poluce",
    "category": "Utility",
    "shortDescription": "将小米蓝牙语音遥控器变成 Windows 无线麦克风",
    "longDescription": "把小米蓝牙语音遥控器变成 Windows 无线麦克风：优先使用 Windows 自带语音输入（Win+H），支持按键映射、虚拟声卡输出与诊断。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Remote Mic"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4MzVGRDRCRjdCNTNENTcKUldSWFBiWDNTLzAxS1ByVDFqcGlHMVpMb0NUYXRrVWRXakMrRGZNT0VOUVJzb1Q0QnNEU2JCa00K",
      "endpoints": [
        "https://github.com/poluce/windows-remote-mic/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
