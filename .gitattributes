# 统一行尾：文本文件在仓库内以 LF 存储，检出时按类型转换。
* text=auto

# 源码 / 脚本 / 配置统一 LF
*.rs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=lf

# Windows 批处理 / VBScript 需要 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf

# 二进制文件不做转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.zip binary
*.dll binary
*.exe binary
*.tgz binary
